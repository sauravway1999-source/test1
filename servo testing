// 1. Blynk Template Settings (Get these from your Blynk Dashboard)
#define BLYNK_TEMPLATE_ID   "YOUR_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "YOUR_TEMPLATE_NAME"
#define BLYNK_AUTH_TOKEN    "YOUR_AUTH_TOKEN"

// 2. Include Libraries
#define BLYNK_PRINT Serial
#include <ESP8266WiFi.h> // Change to <WiFi.h> if using ESP32
#include <BlynkSimpleEsp8266.h> // Change to <BlynkSimpleEsp32.h> if using ESP32
#include <Servo.h>

// 3. WiFi Credentials
char auth[] = BLYNK_AUTH_TOKEN;
char ssid[] = "YOUR_WIFI_NAME";
char pass[] = "YOUR_WIFI_PASSWORD";

// 4. Object Setup
Servo myServo;
int servoPin = 2; // D2 pin on NodeMCU / ESP8266

// 5. Blynk Virtual Pin Function
// This runs whenever you toggle the switch on the Blynk App
BLYNK_WRITE(V1) {
  int pinValue = param.asInt(); // Reads the button state (0 or 1)

  if (pinValue == 1) {
    myServo.write(90);  // Open position (90 degrees)
    Serial.println("Servo Status: OPEN");
  } else {
    myServo.write(0);   // Closed position (0 degrees)
    Serial.println("Servo Status: CLOSED");
  }
}

void setup() {
  Serial.begin(115200);
  
  // Attach servo to pin D2
  myServo.attach(servoPin);
  myServo.write(0); // Start at closed position
  
  // Connect to Blynk
  Blynk.begin(auth, ssid, pass);
}

void loop() {
  Blynk.run(); // Keeps Blynk connection alive
}
